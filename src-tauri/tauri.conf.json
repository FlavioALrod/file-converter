{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Conversor de Arquivos",
  "version": "0.1.0",
  "identifier": "com.fileconverter.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Conversor de Arquivos",
        "width": 980,
        "height": 660,
        "minWidth": 760,
        "minHeight": 520,
        "dragDropEnabled": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "appimage"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ]
  }
}
